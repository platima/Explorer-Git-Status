#include <windows.h>

// Icon order matters: OverlayInfo::iconIndex refers to these by position
// (icon groups are enumerated in ascending resource ID order).
101 ICON "clean.ico"
102 ICON "modified.ico"
103 ICON "aheadbehind.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Explorer Git Status shell extension"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ExplorerGitStatus"
            VALUE "OriginalFilename", "ExplorerGitStatus.dll"
            VALUE "ProductName", "Explorer Git Status"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
